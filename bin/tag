#!/usr/bin/env bash
# Boots the local tagging web tool (etl/tagging_web) so a non-technical
# reviewer on another machine on the same network can fill in tags for a
# year via a single editable browser table.
#
# The browser session is protected with HTTP Basic Auth (credentials
# generated on first run, see etl/config/tagging_web_credentials.txt - never
# committed to git). Edits are saved directly to the tagging CSV, and the
# report page always rebuilds from the latest saved tags.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ETL_DIR="$ROOT_DIR/etl"
PORT="${TAGGING_SERVER_PORT:-4567}"

if [ -t 1 ]; then
  BOLD=$(tput bold) DIM=$(tput dim) RESET=$(tput sgr0)
  GREEN=$(tput setaf 2) CYAN=$(tput setaf 6)
else
  BOLD="" DIM="" RESET="" GREEN="" CYAN=""
fi

header() { echo; echo "${BOLD}${CYAN}== $* ==${RESET}"; }
ok()     { echo "${GREEN}✓ $*${RESET}"; }
info()   { echo "${DIM}$*${RESET}"; }

has_tagging_files() {
  find "$ETL_DIR/tagging" -maxdepth 1 -type f -name '*_tagging.csv' 2>/dev/null | grep -q .
}

has_output_files() {
  find "$ETL_DIR/output" -maxdepth 1 -type f -name '*.csv' 2>/dev/null | grep -q .
}

bootstrap_tagging_from_output() {
  (cd "$ETL_DIR" && bundle exec ruby - <<'RUBY'
require "csv"
require_relative "./lib/etl/tagging_store"

output_paths = Dir.glob(File.join("output", "*.csv"))

output_paths.each do |output_path|
  year = File.basename(output_path, ".csv")
  tagging_path = File.join("tagging", "#{year}_tagging.csv")
  next if File.exist?(tagging_path)

  rows = CSV.read(output_path, headers: true).map do |row|
    {
      "pseudonymous_id" => row["pseudonymous_id"],
      "source_file" => "generated-from-output",
      "gender" => row["gender"],
      "age" => row["age"],
      "sleep_issue" => Etl::TaggingStore.blank_tag,
      "stress_burnout" => Etl::TaggingStore.blank_tag,
      "acupuncture_referral" => Etl::TaggingStore.blank_tag,
      "mental_health_referral" => Etl::TaggingStore.blank_tag,
      "sleep_issue_match" => nil,
      "stress_burnout_match" => nil,
      "acupuncture_referral_match" => nil,
      "mental_health_referral_match" => nil,
      "personal_report_excerpt" => ""
    }
  end

  Etl::TaggingStore.write(tagging_path, rows)
  puts "Wrote #{rows.size} row(s) to #{tagging_path} from #{output_path}"
end
RUBY
  )
}

ensure_tagging_data() {
  if has_tagging_files; then
    ok "Tagging data already present"
    return 0
  fi

  header "Preparing tagging data"
  info "No tagging files found. Running bin/extract automatically..."
  "$ROOT_DIR/bin/extract"

  if has_tagging_files; then
    ok "Tagging data loaded and ready"
  elif has_output_files; then
    info "No tagging CSVs were created by extraction; generating tag-ready files from output CSVs..."
    bootstrap_tagging_from_output

    if has_tagging_files; then
      ok "Tagging data loaded and ready"
    else
      echo "Extraction finished but tagging CSV bootstrap failed." >&2
      exit 1
    fi
  else
    echo "Extraction finished but no tagging or output CSV files were created." >&2
    exit 1
  fi
}

if ! command -v bundle >/dev/null 2>&1; then
  echo "bundle not found on PATH - install Ruby/Bundler first." >&2
  exit 1
fi

header "Tagging web tool setup"
if (cd "$ETL_DIR" && bundle check >/dev/null 2>&1); then
  ok "Ruby gems already installed"
else
  info "Installing Ruby gems (bundle install)..."
  (cd "$ETL_DIR" && bundle install)
fi

ensure_tagging_data

# Generate (or reuse) the basic-auth credentials up front so we can print
# them below, without booting the server first.
CREDENTIALS_FILE="$ETL_DIR/config/tagging_web_credentials.txt"
(cd "$ETL_DIR" && bundle exec ruby -e 'require "./lib/etl/tagging_web_credentials"; Etl::TaggingWebCredentials.load_or_create') 
CREDENTIALS="$(cat "$CREDENTIALS_FILE")"
USERNAME="${CREDENTIALS%%:*}"
PASSWORD="${CREDENTIALS#*:}"

LOCAL_IP="$(ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")"

header "Starting the tagging web tool"
echo "Share these details with the person tagging reports on another machine:"
echo
echo "  ${BOLD}URL:${RESET}      http://${LOCAL_IP}:${PORT}"
echo "  ${BOLD}Username:${RESET} ${USERNAME}"
echo "  ${BOLD}Password:${RESET} ${PASSWORD}"
echo
info "(Both machines must be on the same local network. Credentials are stored"
info " in etl/config/tagging_web_credentials.txt - delete it to generate new ones.)"
info "Edit records and click Save & continue."
info "Open /<year>/report any time - it rebuilds the final report file"
info "at etl/output/<year>.csv"
info "from your latest saved tags without extra command-line steps."
echo
info "Press Ctrl+C to stop the server."
echo

cd "$ETL_DIR/tagging_web"
exec bundle exec puma -b "tcp://0.0.0.0:${PORT}" config.ru
