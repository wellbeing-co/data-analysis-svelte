#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ETL_DIR="$ROOT_DIR/etl"

if [ -t 1 ]; then
  BOLD=$(tput bold) DIM=$(tput dim) RESET=$(tput sgr0)
  GREEN=$(tput setaf 2) YELLOW=$(tput setaf 3) RED=$(tput setaf 1) CYAN=$(tput setaf 6)
else
  BOLD="" DIM="" RESET="" GREEN="" YELLOW="" RED="" CYAN=""
fi

header() {
  echo
  echo "${BOLD}${CYAN}== $* ==${RESET}"
}

info()  { echo "${DIM}$*${RESET}"; }
ok()    { echo "${GREEN}✓ $*${RESET}"; }
warn()  { echo "${YELLOW}! $*${RESET}"; }
fail()  { echo "${RED}✗ $*${RESET}"; }

# ---------------------------------------------------------------------------
# Pre-flight checks
# ---------------------------------------------------------------------------

check_dependencies() {
  header "Checking dependencies"
  local missing=0
  for cmd in ruby bundle; do
    if command -v "$cmd" >/dev/null 2>&1; then
      ok "$cmd found ($(command -v "$cmd"))"
    else
      fail "$cmd not found on PATH"
      missing=1
    fi
  done
  if [ "$missing" -eq 1 ]; then
    fail "Install the missing tool(s) above, then re-run bin/extract."
    exit 1
  fi
}

ensure_etl_deps() {
  header "ETL setup (etl/)"
  if (cd "$ETL_DIR" && bundle check >/dev/null 2>&1); then
    ok "Ruby gems already installed"
  else
    info "Installing Ruby gems (bundle install)..."
    (cd "$ETL_DIR" && bundle install)
  fi
}

# ---------------------------------------------------------------------------
# Year discovery
# ---------------------------------------------------------------------------

discover_years() {
  find "$ROOT_DIR/raw-data" -maxdepth 1 -type d -regex '.*/[0-9][0-9][0-9][0-9]' -printf '%f\n' | sort
}

tagging_path() { echo "$ETL_DIR/tagging/${1}_tagging.csv"; }
output_path()  { echo "$ETL_DIR/output/${1}.csv"; }
raw_year_path() { echo "$ROOT_DIR/raw-data/${1}"; }

pending_tag_count() {
  local file="$1"
  [ -f "$file" ] || { echo -1; return; }
  grep -c 'TODO(Y/N)' "$file" || true
}

has_docx_reports() {
  local year_folder="$1"
  find "$year_folder" -type f -iname '*.docx' ! -iname '~$*' ! -name '.*' -print -quit 2>/dev/null | grep -q .
}

count_docx_top_level() {
  local year_folder="$1"
  find "$year_folder" -maxdepth 1 -type f -iname '*.docx' ! -iname '~$*' ! -name '.*' 2>/dev/null | wc -l | tr -d ' '
}

count_docx_recursive() {
  local year_folder="$1"
  find "$year_folder" -type f -iname '*.docx' ! -iname '~$*' ! -name '.*' 2>/dev/null | wc -l | tr -d ' '
}

count_temp_docx() {
  local year_folder="$1"
  find "$year_folder" -type f -iname '~$*.docx' 2>/dev/null | wc -l | tr -d ' '
}

count_hidden_docx() {
  local year_folder="$1"
  find "$year_folder" -type f -iname '.*.docx' 2>/dev/null | wc -l | tr -d ' '
}

count_docx_with_trailing_spaces() {
  local year_folder="$1"
  find "$year_folder" -type f -iregex '.*\.docx[[:space:]]+$' 2>/dev/null | wc -l | tr -d ' '
}

csv_data_row_count() {
  local path="$1"
  [ -f "$path" ] || {
    echo 0
    return
  }

  local lines
  lines=$(wc -l < "$path")
  if [ "$lines" -le 1 ]; then
    echo 0
  else
    echo $((lines - 1))
  fi
}

show_docx_sample() {
  local year_folder="$1"
  local year="$2"

  local sample
  sample=$(find "$year_folder" -type f -iname '*.docx' ! -iname '~$*' ! -name '.*' 2>/dev/null | sort | head -n 3)
  [ -n "$sample" ] || return

  info "Sample file(s) seen for $year:"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    local rel_path
    rel_path="${path#"$ROOT_DIR/"}"
    info "  - $rel_path"
  done <<< "$sample"
}

log_docx_diagnostics() {
  local year="$1"
  local year_folder
  year_folder="$(raw_year_path "$year")"

  local top_level recursive nested temp hidden trailing
  top_level=$(count_docx_top_level "$year_folder")
  recursive=$(count_docx_recursive "$year_folder")
  nested=$((recursive - top_level))
  temp=$(count_temp_docx "$year_folder")
  hidden=$(count_hidden_docx "$year_folder")
  trailing=$(count_docx_with_trailing_spaces "$year_folder")

  info "raw-data/$year diagnostics: $recursive usable .docx file(s) ($top_level top-level, $nested nested)."
  [ "$temp" -gt 0 ] && warn "Skipped $temp temporary Word lock file(s) (~\$*.docx)."
  [ "$hidden" -gt 0 ] && warn "Skipped $hidden hidden .docx file(s) (starting with .)."
  [ "$trailing" -gt 0 ] && warn "Found $trailing file(s) with trailing spaces after .docx; rename them to end exactly in .docx."

  if [ "$top_level" -eq 0 ] && [ "$nested" -gt 0 ]; then
    warn "No top-level .docx files found, but nested folders contain .docx files. Nested files will be processed."
  fi

  show_docx_sample "$year_folder" "$year"
}

# ---------------------------------------------------------------------------
# Pipeline stages for a single year
# ---------------------------------------------------------------------------

stage_extract() {
  local year="$1"
  header "Year $year - Stage 1: extract report data for tagging"
  (cd "$ETL_DIR" && bundle exec ruby jobs/extract_for_tagging.rb "$year")
}

stage_demo() {
  local year="$1"
  header "Year $year - no reports found, using demo data instead"
  warn "raw-data/$year has no usable .docx reports (after filtering temp/hidden files)."
  info "Generating synthetic demo data so ETL output has something to show for $year."
  mkdir -p "$ETL_DIR/output"
  (cd "$ETL_DIR" && bundle exec ruby bin/generate_demo_data.rb "$year") > "$(output_path "$year")"
  ok "Generated final report output -> etl/output/${year}.csv"
  info "Drop real .docx reports into raw-data/$year/ (or nested subfolders) and re-run bin/extract to replace this with real data."
}

stage_build() {
  local year="$1"
  header "Year $year - Stage 2: build the final anonymised CSV"
  (cd "$ETL_DIR" && bundle exec ruby jobs/build_yearly_csv.rb "$year")
}

process_year() {
  local year="$1"
  local year_folder
  year_folder="$(raw_year_path "$year")"

  log_docx_diagnostics "$year"

  if ! has_docx_reports "$year_folder"; then
    stage_demo "$year"
    return 0
  fi

  stage_extract "$year"

  local tagging_rows
  tagging_rows=$(csv_data_row_count "$(tagging_path "$year")")
  if [ "$tagging_rows" -eq 0 ]; then
    fail "Safety check failed: extraction found .docx files but produced 0 tag rows for $year."
    warn "Check whether the source files are valid .docx reports and readable, then re-run bin/extract --year $year."
    return 1
  fi

  stage_build "$year"
  ok "Year $year is fully processed (final report output: etl/output/${year}.csv)."
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
  local selected_year=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --year)
        [ "$#" -ge 2 ] || { fail "Missing value for --year"; exit 1; }
        selected_year="$2"
        shift 2
        ;;
      *)
        fail "Unknown option: $1"
        info "Usage: bin/extract [--year YYYY]"
        exit 1
        ;;
    esac
  done

  echo "${BOLD}Complete Wellbeing - ETL walkthrough${RESET}"
  echo "${DIM}extract -> browser table edit/save -> report-ready CSV${RESET}"

  check_dependencies
  ensure_etl_deps

  local years=()
  while IFS= read -r y; do years+=("$y"); done < <(discover_years)

  if [ ${#years[@]} -eq 0 ]; then
    fail "No year folders (e.g. raw-data/2023/) found."
    exit 1
  fi

  if [ -n "$selected_year" ]; then
    local matched=0
    for year in "${years[@]}"; do
      if [ "$year" = "$selected_year" ]; then
        matched=1
        break
      fi
    done
    if [ "$matched" -eq 0 ]; then
      fail "Year $selected_year not found under raw-data/."
      exit 1
    fi
    years=("$selected_year")
  fi

  header "Found year folder(s): ${years[*]}"
  local processed=()
  for year in "${years[@]}"; do
    if process_year "$year"; then
      processed+=("$year")
    fi
  done

  if [ ${#processed[@]} -eq 0 ]; then
    warn "No years were processed."
  else
    ok "Processed: ${processed[*]}"
    info "Final report files are available in etl/output/<year>.csv"
    info "Use those CSVs as the dashboard/report page data source."
  fi
}

main "$@"
