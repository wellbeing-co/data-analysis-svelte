#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ETL_DIR="$ROOT_DIR/etl"

if [ -t 1 ]; then
  BOLD=$(tput bold) DIM=$(tput dim) RESET=$(tput sgr0)
  GREEN=$(tput setaf 2) YELLOW=$(tput setaf 3) RED=$(tput setaf 1) CYAN=$(tput setaf 6)
else
  BOLD="" DIM="" RESET="" GREEN="" YELLOW="" RED="" CYAN=""
fi

header() {
  echo
  echo "${BOLD}${CYAN}== $* ==${RESET}"
}

info()  { echo "${DIM}$*${RESET}"; }
ok()    { echo "${GREEN}✓ $*${RESET}"; }
warn()  { echo "${YELLOW}! $*${RESET}"; }
fail()  { echo "${RED}✗ $*${RESET}"; }

# ---------------------------------------------------------------------------
# Pre-flight checks
# ---------------------------------------------------------------------------

check_dependencies() {
  header "Checking dependencies"
  local missing=0
  for cmd in ruby bundle; do
    if command -v "$cmd" >/dev/null 2>&1; then
      ok "$cmd found ($(command -v "$cmd"))"
    else
      fail "$cmd not found on PATH"
      missing=1
    fi
  done
  if [ "$missing" -eq 1 ]; then
    fail "Install the missing tool(s) above, then re-run bin/extract."
    exit 1
  fi
}

ensure_etl_deps() {
  header "ETL setup (etl/)"
  if (cd "$ETL_DIR" && bundle check >/dev/null 2>&1); then
    ok "Ruby gems already installed"
  else
    info "Installing Ruby gems (bundle install)..."
    (cd "$ETL_DIR" && bundle install)
  fi
}

# ---------------------------------------------------------------------------
# Year discovery
# ---------------------------------------------------------------------------

discover_years() {
  find "$ROOT_DIR/raw-data" -maxdepth 1 -type d -regex '.*/[0-9][0-9][0-9][0-9]' -printf '%f\n' | sort
}

tagging_path() { echo "$ETL_DIR/tagging/${1}_tagging.csv"; }
output_path()  { echo "$ETL_DIR/output/${1}.csv"; }
raw_year_path() { echo "$ROOT_DIR/raw-data/${1}"; }

pending_tag_count() {
  local file="$1"
  [ -f "$file" ] || { echo -1; return; }
  grep -c 'TODO(Y/N)' "$file" || true
}

has_docx_reports() {
  local year_folder="$1"
  find "$year_folder" -maxdepth 1 -iname '*.docx' ! -iname '~$*' 2>/dev/null | grep -q .
}

# ---------------------------------------------------------------------------
# Pipeline stages for a single year
# ---------------------------------------------------------------------------

stage_extract() {
  local year="$1"
  header "Year $year - Stage 1: extract report data for tagging"
  (cd "$ETL_DIR" && bundle exec ruby jobs/extract_for_tagging.rb "$year")
}

stage_demo() {
  local year="$1"
  header "Year $year - no reports found, using demo data instead"
  warn "raw-data/$year has no .docx reports in it yet."
  info "Generating synthetic demo data so ETL output has something to show for $year."
  mkdir -p "$ETL_DIR/output"
  (cd "$ETL_DIR" && bundle exec ruby bin/generate_demo_data.rb "$year") > "$(output_path "$year")"
  ok "Generated final report output -> etl/output/${year}.csv"
  info "Drop real .docx reports into raw-data/$year/ and re-run bin/extract to replace this with real data."
}

stage_build() {
  local year="$1"
  header "Year $year - Stage 2: build the final anonymised CSV"
  (cd "$ETL_DIR" && bundle exec ruby jobs/build_yearly_csv.rb "$year")
}

process_year() {
  local year="$1"

  if ! has_docx_reports "$(raw_year_path "$year")"; then
    stage_demo "$year"
    return 0
  fi

  stage_extract "$year"
  stage_build "$year"
  ok "Year $year is fully processed (final report output: etl/output/${year}.csv)."
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
  local selected_year=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --year)
        [ "$#" -ge 2 ] || { fail "Missing value for --year"; exit 1; }
        selected_year="$2"
        shift 2
        ;;
      *)
        fail "Unknown option: $1"
        info "Usage: bin/extract [--year YYYY]"
        exit 1
        ;;
    esac
  done

  echo "${BOLD}Complete Wellbeing - ETL walkthrough${RESET}"
  echo "${DIM}extract -> browser table edit/save -> report-ready CSV${RESET}"

  check_dependencies
  ensure_etl_deps

  local years=()
  while IFS= read -r y; do years+=("$y"); done < <(discover_years)

  if [ ${#years[@]} -eq 0 ]; then
    fail "No year folders (e.g. raw-data/2023/) found."
    exit 1
  fi

  if [ -n "$selected_year" ]; then
    local matched=0
    for year in "${years[@]}"; do
      if [ "$year" = "$selected_year" ]; then
        matched=1
        break
      fi
    done
    if [ "$matched" -eq 0 ]; then
      fail "Year $selected_year not found under raw-data/."
      exit 1
    fi
    years=("$selected_year")
  fi

  header "Found year folder(s): ${years[*]}"
  local processed=()
  for year in "${years[@]}"; do
    if process_year "$year"; then
      processed+=("$year")
    fi
  done

  if [ ${#processed[@]} -eq 0 ]; then
    warn "No years were processed."
  else
    ok "Processed: ${processed[*]}"
    info "Final report files are available in etl/output/<year>.csv"
    info "Use those CSVs as the dashboard/report page data source."
  fi
}

main "$@"
