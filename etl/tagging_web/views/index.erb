<h1>Years awaiting tagging</h1>
<p class="hint">
  Pick a year, review records, and save as you go. The report always uses your
  latest saved tags.
</p>

<% if @years.empty? %>
  <% if @extract_error %>
    <div class="status error"><%= @extract_error %></div>
    <% if @extract_output && !@extract_output.strip.empty? %>
      <pre class="error-log"><%= @extract_output %></pre>
    <% end %>
  <% end %>

  <p>No tagging files found yet. Run extraction here to create the tagging file.</p>
  <form method="post" action="/run-extraction" class="actions">
    <label>
      Year
      <input
        type="text"
        name="year"
        inputmode="numeric"
        pattern="\d{4}"
        maxlength="4"
        placeholder="2025"
        value="<%= @extract_year %>"
        required
      >
    </label>
    <button type="submit">Run extraction</button>
  </form>
<% else %>
  <ul class="year-list">
    <% @years.each do |year| %>
      <% rows = rows_for(year) %>
      <% todo_count = rows.count { |r| tag_columns.any? { |c| r[c] == blank_tag } } %>
      <li class="year-card">
        <div>
          <strong><%= year %></strong>
          <div class="hint"><%= rows.size %> report(s), <%= todo_count %> still untagged</div>
        </div>
        <div class="year-actions">
          <a class="button" href="/<%= year %>/edit">Open</a>
          <a class="button secondary" href="/<%= year %>/report">Report</a>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
